#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E         &kp R  &kp T    &kp Y      &kp U         &kp I      &kp O    &kp P     &kp BSPC
&kp LSHIFT  &kp A  &kp S  &kp D         &kp F  &kp G    &kp H      &kp J         &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C         &kp V  &kp B    &kp N      &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                          &kp LEFT_ALT  &mo 1  &mo 2    &kp SPACE  &kp LEFT_WIN  &kp ENTER
            >;
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5          &kp N7        &kp N8        &kp N9        &kp N0     &kp EQUAL        &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &kp KP_MULTIPLY  &kp DOT
&kp LSHFT   &kp LEFT      &kp DOWN      &kp UP_ARROW  &kp RIGHT     &trans          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &kp BSLH         &trans
                                        &kp LALT      &trans        &trans          &kp SPACE     &kp LEFT_WIN  &kp ENTER
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp F11  &kp F12  &rgb_ug RGB_ON  &rgb_ug RGB_OFF  &kp DEL    &kp PRINTSCREEN  &trans        &trans     &trans    &trans    &kp BSPC
&kp LSHFT  &kp F6   &kp F7   &kp F8          &kp F9           &kp F10    &kp MINUS        &kp EQUAL     &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LCTRL  &kp F1   &kp F2   &kp F3          &kp F4           &kp F5     &kp UNDER        &kp PLUS      &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LALT        &trans           &trans     &kp SPACE        &kp LEFT_WIN  &kp ENTER
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
